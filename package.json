{
  "name": "web",
  "description": "Source of tabnas.dev, the project site and documentation for tabnas.",
  "cloudflare": {
    "label": "Astro Framework Starter",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/394ca3c9-d351-4036-035a-9f6dfa26dd00/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/f40a6577-eed5-4f3e-cef4-b5ef0a1be100/preview",
    "publish": true
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.13",
    "@astrojs/mdx": "4.3.14",
    "@astrojs/sitemap": "3.7.4",
    "@tabnas/abnf": "0.4.14",
    "@tabnas/bnf": "0.1.18",
    "@tabnas/chess-view": "0.1.4",
    "@tabnas/expr": "0.5.9",
    "@tabnas/gbnf": "0.1.10",
    "@tabnas/json": "0.5.9",
    "@tabnas/jsonic": "0.7.0",
    "@tabnas/parser": "0.12.1",
    "@tabnas/semver": "0.0.2",
    "astro": "5.18.2",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "linkedom": "^0.18.13",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "wrangler": "4.137.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.19"
  },
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "node tools/deepen.mjs && astro build && pagefind --site dist && node tools/gen-markdown.mjs",
    "cf-typegen": "wrangler types",
    "check": "npm run check-ax && npm run test-examples && npm run build && npm run check-prose && tsc && npm test && wrangler deploy --dry-run",
    "check-ax": "node tools/check-ax.mjs",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "gen-ax-data": "node tools/gen-ax-data.mjs",
    "preview": "npm run build && wrangler dev",
    "test-examples": "node tools/test-examples.mjs",
    "test": "node --test test/*.test.mjs",
    "check-prose": "node tools/prose.mjs",
    "prose": "node tools/prose.mjs --vale && node tools/vale-counts.mjs",
    "prose-counts": "node tools/vale-counts.mjs --write"
  },
  "type": "module",
  "overrides": {
    "@tabnas/semver": {
      "@tabnas/parser": "0.12.1",
      "@tabnas/abnf": "0.4.14"
    }
  }
}
