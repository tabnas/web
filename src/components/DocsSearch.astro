---
// Custom search box backed by standalone Pagefind. The index is generated
// as a post-build step into /pagefind (see package.json `build`), so it only
// exists after a real build — under `astro dev` there is none and the box
// disables itself gracefully rather than erroring. Use `npm run preview` to
// exercise search locally.
//
// One instance per page: the ids below are fixed, and the client script
// looks them up by id.
interface Props {
  /** Placeholder and accessible label. The index spans every page that
      carries `data-pagefind-body`, which is docs and how-to guides. */
  placeholder?: string;
}
const { placeholder = "Search docs…" } = Astro.props;
---

<div class="docsearch" data-placeholder={placeholder}>
  <input
    id="docsearch-input"
    type="search"
    placeholder={placeholder}
    aria-label={placeholder}
    autocomplete="off"
    disabled
  />
  <div id="docsearch-results" class="results" hidden></div>
</div>

<script>
  const input = document.getElementById("docsearch-input") as HTMLInputElement | null;
  const box = document.getElementById("docsearch-results");
  const ready_placeholder =
    input?.closest<HTMLElement>(".docsearch")?.dataset.placeholder ?? "Search docs…";
  if (input && box) {
    let pf: any = null;
    let ready = false;

    async function ensure() {
      if (ready) return pf;
      ready = true;
      try {
        const path = "/pagefind/pagefind.js";
        pf = await import(/* @vite-ignore */ path);
        await pf.init?.();
        input!.disabled = false;
        input!.placeholder = ready_placeholder;
      } catch {
        input!.placeholder = "Search unavailable";
        input!.disabled = true;
      }
      return pf;
    }

    // Try to enable as soon as the module is available.
    ensure();

    let timer: any;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(run, 180);
    });

    // rehype-autolink-headings appends a literal '#' to every heading, and
    // Pagefind indexes the h1 text with it, so a raw result title reads
    // "Attaching actions#". Strip one trailing '#': a title that genuinely
    // ends in one arrives doubled and still comes out right.
    function cleanTitle(t: string) {
      return String(t).replace(/#$/, "").trim();
    }

    // Which part of the site a result is in, for the label on each row.
    function sectionOf(url: string) {
      if (url.startsWith("/how-to")) return "How to";
      if (url.startsWith("/docs")) return "Docs";
      return "";
    }

    // Pagefind's excerpt is body text, which on these pages starts with the
    // page title — so the raw excerpt repeats the title back at you. Drop a
    // leading copy, then collapse whitespace.
    function cleanExcerpt(excerpt: string, title: string) {
      let out = String(excerpt).replace(/\s+/g, " ").trim();
      const plain = out.replace(/<[^>]*>/g, "");
      if (title && plain.toLowerCase().startsWith(title.toLowerCase())) {
        // Walk past the title in the markup, tag-aware, so <mark> survives.
        let seen = 0;
        let i = 0;
        while (i < out.length && seen < title.length) {
          if ("<" === out[i]) { i = out.indexOf(">", i) + 1 || out.length; continue; }
          seen++; i++;
        }
        out = out.slice(i);
      }
      // Pagefind puts a separator where ignored inline content was (the
      // heading anchors), so an excerpt often starts with stray
      // punctuation once the title prefix is gone.
      return out.replace(/^[\s.,;:#·—–-]+/, "");
    }

    async function run() {
      const q = input!.value.trim();
      if (!q || !pf) {
        box!.hidden = true;
        box!.innerHTML = "";
        return;
      }
      const search = await pf.search(q);
      const items = await Promise.all(search.results.slice(0, 6).map((r: any) => r.data()));
      if (!items.length) {
        box!.innerHTML = `<p class="ds-none">No results for &ldquo;${escapeHtml(q)}&rdquo;</p>`;
        box!.hidden = false;
        return;
      }
      box!.innerHTML = items
        .map((d: any) => {
          const title = cleanTitle(d.meta?.title || d.url);
          const section = sectionOf(d.url);
          const excerpt = cleanExcerpt(d.excerpt, title);
          return (
            `<a class="ds-hit" href="${d.url}">` +
            `<span class="ds-head">` +
            `<span class="ds-title">${escapeHtml(title)}</span>` +
            (section ? `<span class="ds-where">${section}</span>` : "") +
            `</span>` +
            (excerpt ? `<span class="ds-excerpt">${excerpt}</span>` : "") +
            `</a>`
          );
        })
        .join("");
      box!.hidden = false;
    }

    function escapeHtml(s: string) {
      return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
    }

    // Escape closes the panel without losing the query.
    input.addEventListener("keydown", (e) => {
      if ("Escape" === (e as KeyboardEvent).key) box!.hidden = true;
    });

    document.addEventListener("click", (e) => {
      if (!(e.target as Element)?.closest?.(".docsearch")) box!.hidden = true;
    });
  }
</script>

<style>
  .docsearch { position: relative; margin-bottom: 1.5rem; }
  .docsearch input {
    width: 100%; box-sizing: border-box;
    font-family: var(--font-body); font-size: 0.92rem; color: var(--ink);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 9px; padding: 0.5rem 0.75rem;
  }
  .docsearch input:focus { outline: 2px solid var(--ring); outline-offset: 1px; border-color: var(--border-strong); }
  .docsearch input:disabled { opacity: 0.6; }
  .results {
    position: absolute; z-index: 20; top: calc(100% + 0.4rem); left: 0; right: 0;
    background: var(--surface); border: 1px solid var(--border-strong);
    border-radius: 12px; box-shadow: var(--shadow);
    padding: 0.3rem; max-height: 60vh; overflow-y: auto; overscroll-behavior: contain;
  }

  /* Result rows are injected with innerHTML, so Astro's scoped attribute
     never lands on them and a plain `.results a { … }` rule silently does
     nothing — which is why these are :global. Keep them that way. */
  .results :global(.ds-hit) {
    display: block; padding: 0.55rem 0.65rem; border-radius: 8px;
    text-decoration: none; color: var(--ink);
  }
  .results :global(.ds-hit + .ds-hit) {
    border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }
  .results :global(.ds-hit:hover) {
    background: color-mix(in srgb, var(--accent-strong) 12%, transparent);
    border-top-color: transparent;
  }
  .results :global(.ds-hit:hover + .ds-hit) { border-top-color: transparent; }
  .results :global(.ds-hit:focus-visible) {
    outline: 2px solid var(--ring); outline-offset: -2px;
  }

  .results :global(.ds-head) {
    display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.15rem;
  }
  .results :global(.ds-title) {
    color: var(--primary); font-weight: 600; font-size: 0.92rem;
    line-height: 1.3; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .results :global(.ds-where) {
    margin-left: auto; flex: none;
    font-family: var(--font-mono); font-size: 0.62rem;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--ink-mute);
    border: 1px solid var(--border); border-radius: 999px;
    padding: 0.05rem 0.4rem;
  }
  .results :global(.ds-excerpt) {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--ink-soft); font-size: 0.82rem; line-height: 1.45;
  }
  .results :global(mark) {
    background: color-mix(in srgb, var(--accent-strong) 30%, transparent);
    color: inherit; border-radius: 3px; padding: 0 0.1em;
    font-weight: 600;
  }
  .results :global(.ds-none) {
    color: var(--ink-mute); font-size: 0.85rem;
    padding: 0.7rem 0.65rem; margin: 0;
  }
</style>
