---
// Custom search box backed by standalone Pagefind. The Pagefind index is
// generated as a post-build step into /pagefind (see package.json `build`).
// It only exists for prerendered/static HTML, so while the site runs under
// the SSR under-construction gate the index may be absent — the box then
// disables itself gracefully instead of erroring.
---

<div class="docsearch">
  <input
    id="docsearch-input"
    type="search"
    placeholder="Search docs…"
    aria-label="Search docs"
    autocomplete="off"
    disabled
  />
  <div id="docsearch-results" class="results" hidden></div>
</div>

<script>
  const input = document.getElementById("docsearch-input") as HTMLInputElement | null;
  const box = document.getElementById("docsearch-results");
  if (input && box) {
    let pf: any = null;
    let ready = false;

    async function ensure() {
      if (ready) return pf;
      ready = true;
      try {
        const path = "/pagefind/pagefind.js";
        pf = await import(/* @vite-ignore */ path);
        await pf.init?.();
        input!.disabled = false;
        input!.placeholder = "Search docs…";
      } catch {
        input!.placeholder = "Search unavailable";
        input!.disabled = true;
      }
      return pf;
    }

    // Try to enable as soon as the module is available.
    ensure();

    let timer: any;
    input.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(run, 180);
    });

    async function run() {
      const q = input!.value.trim();
      if (!q || !pf) {
        box!.hidden = true;
        box!.innerHTML = "";
        return;
      }
      const search = await pf.search(q);
      const items = await Promise.all(search.results.slice(0, 6).map((r: any) => r.data()));
      if (!items.length) {
        box!.innerHTML = `<p class="none">No results for “${escapeHtml(q)}”.</p>`;
        box!.hidden = false;
        return;
      }
      box!.innerHTML = items
        .map(
          (d: any) =>
            `<a href="${d.url}"><strong>${escapeHtml(d.meta?.title || d.url)}</strong><span>${d.excerpt}</span></a>`,
        )
        .join("");
      box!.hidden = false;
    }

    function escapeHtml(s: string) {
      return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
    }

    document.addEventListener("click", (e) => {
      if (!(e.target as Element)?.closest?.(".docsearch")) box!.hidden = true;
    });
  }
</script>

<style>
  .docsearch { position: relative; margin-bottom: 1.5rem; }
  .docsearch input {
    width: 100%; box-sizing: border-box;
    font-family: var(--font-body); font-size: 0.92rem; color: var(--ink);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 9px; padding: 0.5rem 0.75rem;
  }
  .docsearch input:focus { outline: 2px solid var(--ring); outline-offset: 1px; border-color: var(--border-strong); }
  .docsearch input:disabled { opacity: 0.6; }
  .results {
    position: absolute; z-index: 20; top: calc(100% + 0.35rem); left: 0; right: 0;
    background: var(--surface); border: 1px solid var(--border-strong);
    border-radius: 10px; box-shadow: var(--shadow); padding: 0.35rem; max-height: 60vh; overflow-y: auto;
  }
  .results a {
    display: block; padding: 0.5rem 0.6rem; border-radius: 7px;
    text-decoration: none; color: var(--ink);
  }
  .results a:hover { background: color-mix(in srgb, var(--accent-strong) 12%, transparent); }
  .results strong { display: block; color: var(--primary); font-size: 0.92rem; }
  .results span { display: block; color: var(--ink-soft); font-size: 0.82rem; margin-top: 0.15rem; }
  .results :global(mark) { background: color-mix(in srgb, var(--accent-strong) 35%, transparent); color: inherit; border-radius: 2px; }
  .results .none { color: var(--ink-mute); font-size: 0.88rem; padding: 0.5rem 0.6rem; margin: 0; }
</style>
