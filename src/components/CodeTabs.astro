---
// A code example shown three ways: TypeScript, Go, and prose.
//
// The sources are read from examples/<id>/ at build time — the SAME files
// tools/test-examples.mjs executes and compares against expect.txt. So the
// code on the page is the code that was run, and the two language versions
// are known to produce identical output rather than merely claimed to.
//
//   <CodeTabs id="abnf-actions" label="ABNF in, a parser out" />
//
// Tabs are radio inputs, so switching works with CSS alone: no JavaScript,
// and every version is present in the HTML for search and for reader mode.
import { readFileSync, existsSync } from 'node:fs'
import { join } from 'node:path'
import { codeToHtml } from 'shiki'

interface Props {
  id: string
  label?: string
  /**
   * Trim the TypeScript source to these line ranges, 1-based inclusive,
   * e.g. [[1,12]]. Applies to ts.ts ONLY — the Go file is a different length
   * and a different shape, so the same range cuts it at an unrelated point.
   * Use goLines to abridge Go.
   */
  lines?: [number, number][]
  /**
   * Trim the Go source, independently of `lines`. Omit to show Go in full and
   * let its pane scroll: that is the point of the overlay layout below, and it
   * is what the reader needs, since a Go example that stops mid-statement is
   * worse than a long one.
   */
  goLines?: [number, number][]
  /**
   * Suffix that keeps the radio group unique when one example appears twice on
   * a page — abridged in the hero, in full further down, say. Without it both
   * copies share a name and an element id, so the two tab bars fight over
   * which pane is showing.
   */
  instance?: string
}

const { id, label, lines, goLines, instance } = Astro.props

const dir = join(process.cwd(), 'examples', id)
const read = (p: string) => (existsSync(p) ? readFileSync(p, 'utf8') : '')

function abridge(src: string, ranges?: [number, number][]) {
  if (!ranges) return src.trimEnd()
  return ranges
    .map(([from, to]) => src.split('\n').slice(from - 1, to).join('\n'))
    .join('\n')
    .trimEnd()
}

const tsSrc = abridge(read(join(dir, 'ts.ts')), lines)
const goSrc = abridge(read(join(dir, 'go', 'main.go')), goLines)
const explain = read(join(dir, 'explain.md')).trim()
const expected = read(join(dir, 'expect.txt')).trim()

if (!tsSrc) throw new Error(`CodeTabs: examples/${id}/ts.ts is missing or empty`)

// Both themes are emitted; global CSS picks one by prefers-color-scheme.
//
// Both GitHub themes set comments in a grey chosen against their own
// background. Ours is a dull green, and against it those greys fall to 4.09:1
// (light) and 3.32:1 (dark) — under the 4.5:1 WCAG AA floor. Comments carry
// the explanation in these examples, so they are the last text that should be
// hard to read. Shiki inlines its colours per span, so the fix is to remap the
// one offending value on the way out; everything else already clears AA.
const CONTRAST_FIX: Record<string, string> = {
  '#6e7781': '#656d76', // light comment: 4.09 -> 4.72 on #f0f4ee
  '#6a737d': '#8b949e', // dark comment:  3.32 -> 5.20 on #10261a
}
// Shiki separates its per-line spans with a literal newline:
//   <span class="line">…</span>\n<span class="line">…</span>
// The CSS below gives .line `display: block` so a wrapped line can hang its
// continuation. Block display and a preserved newline BOTH break the line, so
// together they render every code block double-spaced. Drop the newlines and
// let display:block do the breaking. Blank lines arrive as an empty
// <span class="line"></span>, which an empty block would collapse to zero
// height, so the CSS gives those a zero-width space.
const dropLineBreaks = (html: string) => html.replace(/\n(?=<span class="line")/g, '')

const hl = async (code: string, lang: string) => {
  const html = await codeToHtml(code, {
    lang,
    themes: { light: 'github-light-default', dark: 'github-dark' },
  })
  return dropLineBreaks(
    html.replace(/#[0-9a-fA-F]{6}/g, (c) => CONTRAST_FIX[c.toLowerCase()] ?? c),
  )
}

const tsHtml = await hl(tsSrc, 'ts')
const goHtml = goSrc ? await hl(goSrc, 'go') : ''

// Minimal markdown for the explain prose: paragraphs plus `code` spans.
const esc = (s: string) =>
  s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c] as string)
const explainHtml = explain
  .split(/\n{2,}/)
  .map(
    (p) =>
      '<p>' +
      esc(p.replace(/\n/g, ' '))
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>') +
      '</p>',
  )
  .join('\n')

const name = `tabs-${id}${instance ? `-${instance}` : ''}`
---

<div class="codetabs" data-example={id}>
  {label && <p class="code-label">{label}</p>}

  <div class="tabbar" role="tablist" aria-label={`${id} code`}>
    <input type="radio" name={name} id={`${name}-ts`} checked />
    <label for={`${name}-ts`}>TypeScript</label>

    {goHtml && <input type="radio" name={name} id={`${name}-go`} />}
    {goHtml && <label for={`${name}-go`}>Go</label>}

    {explainHtml && <input type="radio" name={name} id={`${name}-ex`} />}
    {explainHtml && <label for={`${name}-ex`}>Explain</label>}

    <div class="panes">
      <div class="pane pane-ts" set:html={tsHtml} />
      {goHtml && <div class="pane pane-go" set:html={goHtml} />}
      {explainHtml && <div class="pane pane-ex prose" set:html={explainHtml} />}
    </div>
  </div>

  {expected && (
    <p class="code-out">
      <span>output</span>
      <code>{expected.replace(/\n/g, ' · ')}</code>
    </p>
  )}
</div>

<style>
  .codetabs {
    margin: 0 0 1rem;
    /* A very light, dull green — desaturated so syntax colours stay legible
       against it, and distinct from the parchment page background. */
    --codetabs-bg: #f0f4ee;
    /* An overflowing <pre> must scroll inside itself, never widen the page.
       Without this the block ran past the viewport on narrow screens and the
       left edge — rounded corner and all — was scrolled out of sight. */
    min-width: 0;
    max-width: 100%;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .codetabs { --codetabs-bg: #10261a; }
  }
  :root[data-theme="dark"] .codetabs { --codetabs-bg: #10261a; }
  :root[data-theme="light"] .codetabs { --codetabs-bg: #f0f4ee; }

  /* Radio-driven tabs: the inputs sit before the panes so a sibling selector
     can reveal the matching one. No JavaScript involved. */
  .tabbar > input { position: absolute; opacity: 0; pointer-events: none; }

  .tabbar > label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
    padding: 0.35rem 0.7rem;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
  }
  .tabbar > label:hover { color: var(--ink); }
  .tabbar > input:checked + label {
    color: var(--ink);
    background: var(--surface);
    border-color: var(--border);
  }
  /* Keyboard focus must stay visible — the input itself is off-screen. */
  .tabbar > input:focus-visible + label { outline: 2px solid var(--ring); outline-offset: 2px; }

  /* The TypeScript pane stays in normal flow whichever tab is showing, so it
     alone sets the block's height. Go and Explain are laid over it and scroll
     when they are longer — otherwise a longer Go version was simply cut off,
     and switching tabs made the page jump. */
  .panes { position: relative; margin-top: -1px; min-width: 0; }
  .pane { visibility: hidden; }
  .pane-go,
  .pane-ex {
    position: absolute;
    inset: 0;
    overflow: auto;
  }
  .tabbar > input:nth-of-type(1):checked ~ .panes .pane-ts,
  .tabbar > input:nth-of-type(2):checked ~ .panes .pane-go,
  .tabbar > input:nth-of-type(3):checked ~ .panes .pane-ex { visibility: visible; }

  .pane :global(pre) {
    margin: 0;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 0 10px 10px 10px;
    font-size: 0.82rem;
    line-height: 1.6;
    overflow-x: auto;
    /* Shiki inlines its theme background; ours is the dull green below. */
    background: var(--codetabs-bg) !important;
    min-height: 100%;
    box-sizing: border-box;
    min-width: 0;
  }
  .pane.prose {
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 0 10px 10px 10px;
    background: var(--codetabs-bg);
    box-sizing: border-box;
    min-height: 100%;
  }
  .pane.prose :global(p) { margin: 0 0 0.7rem; font-size: 0.88rem; color: var(--ink-soft); }
  .pane.prose :global(p:last-child) { margin-bottom: 0; }
  .pane.prose :global(code) { font-family: var(--font-mono); font-size: 0.85em; color: var(--ink); }

  /* Shiki emits BOTH themes: a `color` for light and a --shiki-dark custom
     property for dark. Nothing swaps them on its own — the site has to. Since
     we also override the background, missing this put the light theme's dark
     grey text on our dark green background, which was unreadable. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .pane :global(.shiki),
    :root:not([data-theme="light"]) .pane :global(.shiki span) {
      color: var(--shiki-dark) !important;
    }
  }
  :root[data-theme="dark"] .pane :global(.shiki),
  :root[data-theme="dark"] .pane :global(.shiki span) {
    color: var(--shiki-dark) !important;
  }

  /* One block per source line, at every width. The newlines Shiki puts between
     these spans are stripped in the component (see dropLineBreaks) — leaving
     them in place alongside display:block is what double-spaced every code
     block on iOS Safari and everywhere else. */
  .pane :global(.line) { display: block; }
  /* A blank source line is an EMPTY span. An empty block generates no line box
     and would collapse to nothing, silently closing up the gaps the author
     wrote. A zero-width space gives it one line's height. */
  .pane :global(.line:empty)::before { content: "\200b"; }

  /* On a phone, sideways scrolling inside a page that already scrolls
     vertically is easy to miss entirely — a truncated line just looks like the
     end of the line. Below the site's 720px breakpoint, wrap instead, and hang
     the continuation so a wrapped line still reads as one statement. The
     indent belongs on span.line, not on the <code> (which would only indent
     the first line of the whole block). */
  @media (max-width: 720px) {
    .pane :global(pre),
    .pane :global(code) {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .pane :global(pre) { overflow-x: visible; }
    .pane :global(.line) { text-indent: -2ch; padding-left: 2ch; }
  }

  .code-out {
    display: flex; gap: 0.5rem; align-items: baseline;
    flex-wrap: wrap; min-width: 0;   /* a long output line wraps, never widens */
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--ink-mute); margin: 0.5rem 0 0;
  }
  .code-out code { overflow-wrap: anywhere; }
  .code-out span { text-transform: uppercase; letter-spacing: 0.1em; }
  .code-out code { color: var(--ink-soft); }
</style>
