---
import { GITHUB_ORG } from "../consts";
---

<div class="signals" id="signals" aria-label="Project activity">
  <div class="sig"><span class="n" id="sig-stars">—</span><span class="l">stars</span></div>
  <div class="sig"><span class="n" id="sig-release">—</span><span class="l">latest release</span></div>
  <a class="sig" id="sig-gfi-link" href={`${GITHUB_ORG}/parser/contribute`} target="_blank" rel="noopener">
    <span class="n" id="sig-gfi">—</span><span class="l">good first issues</span>
  </a>
</div>

<script is:inline>
  // Live project signals (unauthenticated GitHub API; best-effort).
  // is:inline — Astro drops hoisted component scripts on MDX pages
  // rendered through a layout, so this must stay unprocessed.
  (async () => {
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    try {
      const res = await fetch("https://api.github.com/orgs/tabnas/repos?per_page=100&type=public");
      if (res.ok) {
        const repos = await res.json();
        const stars = repos.reduce((n, r) => n + (r.stargazers_count || 0), 0);
        set("sig-stars", stars >= 1000 ? (stars / 1000).toFixed(1) + "k" : String(stars));
      }
    } catch {}
    try {
      const res = await fetch("https://api.github.com/repos/tabnas/parser/releases/latest");
      if (res.ok) { const r = await res.json(); set("sig-release", r.tag_name || "—"); }
      else set("sig-release", "—");
    } catch {}
    try {
      const res = await fetch('https://api.github.com/search/issues?q=' +
        encodeURIComponent('org:tabnas is:issue is:open label:"good first issue"'));
      if (res.ok) { const r = await res.json(); set("sig-gfi", String(r.total_count ?? 0)); }
    } catch {}
  })();
</script>

<style>
  .signals { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; align-items: center;
    border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.3rem; margin: 1.25rem 0 1.75rem;
    background: var(--surface); }
  .sig { display: flex; flex-direction: column; text-decoration: none; line-height: 1.15; }
  .sig .n { font-family: var(--font-heading); font-weight: 700; font-size: 1.5rem; color: var(--primary); font-variant-numeric: tabular-nums; }
  .sig .l { font-size: 0.75rem; color: var(--ink-mute); text-transform: uppercase; letter-spacing: 0.08em; }
  a.sig:hover .n { text-decoration: underline; }
</style>
