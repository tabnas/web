---
import { NAV, SITE_TITLE, GITHUB_ORG } from "../consts";
import mark from "../assets/brand/mark.svg";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
      <img src={mark.src} width="40" height="40" alt="" aria-hidden="true" />
      <span class="word">tabnas</span>
    </a>

    <button
      class="menu-btn"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="nav">
      {NAV.map((item) => (
        <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
      <div class="actions">
        <a class="icon-link" href={GITHUB_ORG} target="_blank" rel="noopener" aria-label="tabnas on GitHub">
          <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
        </a>
        <button class="icon-link theme-toggle" aria-label="Toggle colour theme">
          <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-13a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1Zm0 15a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1ZM4 12a1 1 0 0 1-1 1H2a1 1 0 1 1 0-2h1a1 1 0 0 1 1 1Zm18 0a1 1 0 0 1-1 1h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 1 1ZM5.6 5.6a1 1 0 0 1 1.4 0l.7.7a1 1 0 1 1-1.4 1.4l-.7-.7a1 1 0 0 1 0-1.4Zm11 11a1 1 0 0 1 1.4 0l.7.7a1 1 0 1 1-1.4 1.4l-.7-.7a1 1 0 0 1 0-1.4Zm1.4-11a1 1 0 0 1 0 1.4l-.7.7a1 1 0 1 1-1.4-1.4l.7-.7a1 1 0 0 1 1.4 0Zm-11 11a1 1 0 0 1 0 1.4l-.7.7a1 1 0 0 1-1.4-1.4l.7-.7a1 1 0 0 1 1.4 0Z"></path></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0.55rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand img { display: block; filter: drop-shadow(0 1px 2px rgba(11, 45, 26, 0.25)); }
  .brand .word {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
    color: var(--primary);
    letter-spacing: 0.01em;
  }
  .nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    /* Backstop: if the row ever outgrows the bar — one nav item too many,
       or a wide fallback font before the webfont lands — the links wrap
       onto a second line instead of scrolling the whole page sideways.
       The breakpoint below is set so this should not normally trigger. */
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .nav-link {
    font-family: var(--font-body);
    font-size: 0.98rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    border-bottom: 2px solid transparent;
    /* Without this, a cramped row squashes labels into two lines each
       rather than letting the nav wrap as a whole. */
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--ink); background: color-mix(in srgb, var(--accent-strong) 12%, transparent); }
  .nav-link.active { color: var(--primary); border-bottom-color: var(--accent-strong); }
  .actions { display: flex; align-items: center; gap: 0.25rem; margin-left: 0.4rem; }
  .icon-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 9px;
    color: var(--ink-soft); background: none; border: none; cursor: pointer;
    text-decoration: none;
  }
  .icon-link:hover { color: var(--primary); background: color-mix(in srgb, var(--accent-strong) 12%, transparent); }
  .theme-toggle .i-moon { display: none; }
  :root[data-theme="dark"] .theme-toggle .i-sun { display: none; }
  :root[data-theme="dark"] .theme-toggle .i-moon { display: block; }

  .menu-btn {
    display: none;
    margin-left: auto;
    flex-direction: column;
    gap: 4px;
    width: 40px; height: 40px;
    align-items: center; justify-content: center;
    background: none; border: 1px solid var(--border); border-radius: 9px; cursor: pointer;
  }
  .menu-btn span { display: block; width: 18px; height: 2px; background: var(--ink); border-radius: 2px; }

  /* Collapse to the menu button while the full row still fits.
     Brand (160px) + nav (719px) + gap + padding needs ~935px, so the
     horizontal nav only appears above that. It used to collapse at 760px,
     which left 761–935px squashing the links and scrolling the page
     sideways. Re-measure this number when the nav gains an item:
     `.brand` width + `.nav` width at a wide viewport, + 56px. */
  @media (max-width: 960px) {
    .menu-btn { display: flex; }
    .nav {
      position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0.15rem;
      background: var(--surface); border-bottom: 1px solid var(--border);
      padding: 0.75rem 1.25rem 1rem;
      box-shadow: var(--shadow);
      display: none;
    }
    .nav.open { display: flex; }
    .nav-link { padding: 0.6rem 0.5rem; }
    .actions { margin: 0.4rem 0 0; }
    /* The dropdown is a column, so the desktop wrap backstop would
       otherwise stretch each link to the row height. */
    .nav { flex-wrap: nowrap; justify-content: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header { backdrop-filter: none; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.querySelector(".menu-btn");
    const nav = document.getElementById("site-nav");
    if (btn && nav) {
      btn.addEventListener("click", () => {
        const open = nav.classList.toggle("open");
        btn.setAttribute("aria-expanded", String(open));
      });
    }
    const toggle = document.querySelector(".theme-toggle");
    if (toggle) {
      toggle.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.getAttribute("data-theme") === "dark";
        const next = dark ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch {}
      });
    }
  })();
</script>
