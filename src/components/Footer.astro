---
import { NAV, GITHUB_ORG, NPM_ORG, STATUS_URL, SPONSOR, SITE_MOTTO } from "../consts";
const year = new Date().getFullYear();

const resources = [
  { href: GITHUB_ORG, label: "GitHub org" },
  { href: NPM_ORG, label: "npm packages" },
  { href: STATUS_URL, label: "Org status" },
];
---

<footer class="site-footer">
  <div class="inner">
    <div class="cols">
      <div class="about">
        <span class="word">tabnas</span>
        <p class="motto">{SITE_MOTTO} — a table of translations.</p>
        <a class="sponsor" href={SPONSOR.url} target="_blank" rel="noopener">
          <span>Sponsored by</span> <strong>{SPONSOR.name}</strong>
        </a>
      </div>

      <nav class="col" aria-label="Site">
        <h2>Site</h2>
        {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
      </nav>

      <nav class="col" aria-label="Resources">
        <h2>Resources</h2>
        {resources.map((i) => (
          <a href={i.href} target="_blank" rel="noopener">{i.label}</a>
        ))}
      </nav>
    </div>

    <div class="legal">
      <span>© {year} {SPONSOR.name}. Open source under the MIT License.</span>
      <span class="build">Built with Astro on Cloudflare.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    background:
      linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent-strong) 6%, transparent));
    color: var(--ink-soft);
  }
  .inner { max-width: 1120px; margin: 0 auto; padding: 3rem 1.25rem 3.5rem; }
  .cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2rem;
  }
  .about .word {
    font-family: var(--font-display);
    font-size: 1.9rem;
    color: var(--primary);
    line-height: 1;
  }
  .motto {
    font-family: var(--font-heading);
    font-style: italic;
    color: var(--ink-mute);
    margin: 0.4rem 0 1rem;
    max-width: 34ch;
  }
  .sponsor {
    display: inline-flex; align-items: baseline; gap: 0.35rem;
    text-decoration: none; color: var(--ink-soft);
    border: 1px solid var(--border-strong); border-radius: 999px;
    padding: 0.4rem 0.85rem; font-size: 0.9rem;
  }
  .sponsor span { color: var(--ink-mute); }
  .sponsor strong { color: var(--accent); font-family: var(--font-heading); font-size: 1.05rem; }
  .sponsor:hover { border-color: var(--accent); }

  .col { display: flex; flex-direction: column; gap: 0.5rem; }
  .col h2 {
    font-family: var(--font-mono);
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--ink-mute); margin: 0 0 0.35rem;
  }
  .col a { color: var(--ink-soft); text-decoration: none; font-size: 0.95rem; }
  .col a:hover { color: var(--primary); }

  .legal {
    margin-top: 2.5rem; padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    font-size: 0.85rem; color: var(--ink-mute);
  }

  @media (max-width: 680px) {
    .cols { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
