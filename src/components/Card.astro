---
// One cell of a <CardGrid>. The body is the slot — in MDX, write plain
// markdown between the tags. With `href` the whole card is a link.
import { slugify } from "../utils/slug";

interface Props {
  title: string;
  href?: string;
  /** Heading level for the title; pick to fit the page outline. */
  level?: "h2" | "h3";
  /** Override the derived fragment id. */
  id?: string;
}
const { title, href, level = "h3", id } = Astro.props;
const Tag = href ? "a" : "article";
const external = href?.startsWith("http");
const Heading = level;
const slug = id ?? slugify(title);
---

<Tag
  class="card"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
>
  <Heading id={slug}>
    {title}
    {/* A whole-card link would swallow a nested anchor, so only plain
        (non-href) cards get one. */}
    {!href && (
      <a class="heading-anchor" data-pagefind-ignore href={`#${slug}`} aria-hidden="true" tabindex="-1">#</a>
    )}
  </Heading>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
  }
  a.card:hover { border-color: var(--border-strong); }
  .card h2, .card h3 { font-size: 1.2rem; margin: 0 0 0.4rem; color: var(--ink); }
  /* Slotted markdown paragraphs (rendered outside this component's scope). */
  .card :global(p) { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  .card :global(p + p) { margin-top: 0.6rem; }
</style>
