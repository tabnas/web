---
import Base from "../layouts/Base.astro";
import Heading from "../components/Heading.astro";
import { REPO, GITHUB_ORG } from "../consts";

// Anderssen–Kieseritzky, London, 21 June 1851 — "the Immortal Game".
//
// A game score is a record of what happened, not an authored work, so the
// moves carry no copyright; the annotations written ABOUT a game do, and
// there are none here. An 1851 game puts it beyond argument either way.
//
// Every ply is checked against the legal move generator in chess/web —
// 45 plies, ending in mate on d8 — so a typo here shows up as a flagged
// move in the board rather than as a wrong position.
const IMMORTAL = `[Event "Casual game"]
[Site "London ENG"]
[Date "1851.06.21"]
[White "Adolf Anderssen"]
[Black "Lionel Kieseritzky"]
[Result "1-0"]

1. e4 e5 2. f4 exf4 3. Bc4 Qh4+ 4. Kf1 b5 5. Bxb5 Nf6 6. Nf3 Qh6
7. d3 Nh5 8. Nh4 Qg5 9. Nf5 c6 10. g4 Nf6 11. Rg1 cxb5 12. h4 Qg6
13. h5 Qg5 14. Qf3 Ng8 15. Bxf4 Qf6 16. Nc3 Bc5 17. Nd5 Qxb2 18. Bd6 Bxg1
19. e5 Qxa1+ 20. Ke2 Na6 21. Nxg7+ Kd8 22. Qf6+ Nxf6 23. Be7# 1-0`;

// Two boxes of version strings, seeded so the demo shows both what semver
// makes easy and what it makes hard. Every line was run through
// @tabnas/semver before it went on the page: the nine accepts produce the
// values the prose describes, `v1.2.3` is the one rejection, and the
// precedence strip comes out
//
//   0.9.0 < 1.0.0-alpha.beta.11+exp.sha.5114f85 < 1.0.0-beta.2
//         < 1.0.0-beta.11 < 1.0.0-x-y-z.-- < 1.0.0 < 1.2.3 < 2.0.0
//         < 9007199254740992.0.0
//
// which is the whole of section 11 in one line: numeric identifiers sort by
// value (beta.2 before beta.11, not after), every pre-release sorts below
// the release it leads to, and build metadata counts for nothing.
const SEMVER_SIMPLE = ["0.9.0", "1.0.0", "1.2.3", "2.0.0"].join("\n");

const SEMVER_COMPLEX = [
  "1.0.0-beta.2",
  "1.0.0-beta.11",
  "1.0.0-alpha.beta.11+exp.sha.5114f85",
  "1.0.0-x-y-z.--",
  "9007199254740992.0.0",
  "v1.2.3",
].join("\n");

// A constrained-decoding grammar small enough to read whole, and five
// samples that between them show both directions. Every verdict below was
// checked against @tabnas/gbnf before it went on the page: the two accepts
// pass, and the three rejects fail for three different reasons — an
// alternative that is not in the rule, a missing terminal, and a second
// space. That last one is the scannerless point made concrete.
const GBNF_GRAMMAR = `root    ::= answer " (" conf ")"
answer  ::= "yes" | "no"
conf    ::= digit+ "%"
digit   ::= [0-9]`;

const GBNF_SAMPLES = [
  "yes (90%)",
  "no (5%)",
  "maybe (50%)",
  "yes (90)",
  "yes  (90%)",
].join("\n");

// Real languages built on the engine. Package lists are read from each
// project's own manifests — keep them accurate, or drop them.
const PROJECTS = [
  {
    id: "aontu",
    name: "aontu",
    url: "https://github.com/rjrodger/aontu",
    tagline: "A JSON structure unifier, in TypeScript",
    runtime: "TypeScript · also ported to Go",
    uses: ["jsonic", "expr", "directive", "multisource", "path", "debug"],
    body: [
      `Aontu unifies JSON structures: you write schemas and unification rules,
       and it folds many partial configurations into one consistent result. The
       language is a purpose-specific dialect of CUE: compact enough to write
       inline (\`a:1 b:$.a\`), with file evaluation and a REPL.`,
      `It is the clearest example of what the plugin model is for. Aontu defines
       no parser of its own. It starts from the jsonic grammar and layers on the
       pieces it needs: expressions for computed values, directives for
       \`@\`-forms, multisource so one document can pull in others, and path
       tracking so a reference like \`$.a\` knows where it is. The language is
       assembled out of grammar plugins rather than written from scratch.`,
    ],
  },
  {
    id: "boru",
    name: "boru",
    url: "https://github.com/boru-lang/boru",
    tagline: "A typed, word-based query language, in Go",
    runtime: "Go",
    uses: ["parser", "jsonic", "abnf", "csv", "expr"],
    body: [
      `A boru program is a sequence of words, and a word takes its arguments
       where you write them: \`add 1 2\` reads left to right like an ordinary
       call, while binary operations also read naturally infix (\`10 sub 3\`).
       It aims to keep the composability of concatenative, stack-based languages
       without making you track the stack in your head.`,
      `The language is substantial: hierarchical types with typed signatures
       driving dispatch, lists and maps and records, hygienic macros,
       concurrency: and the toolchain around it is too: parser, type checker,
       formatter and LSP server all ship in one CLI. That whole front end is
       built on the tabnas engine in Go, which makes boru the answer to whether
       this scales past config formats.`,
    ],
  },
];

// The links at the top of the page, in page order. Each id is the same
// string the matching <Heading id> carries below, and those ids are public
// URLs — so a rename is two edits, here and at the heading. The two project
// entries are read from PROJECTS rather than repeated, and
// test/artifacts.test.mjs fails the build if any link on the site points at
// a fragment no element on that page has.
const SECTIONS: { id: string; label: string; blurb: string }[] = [
  {
    id: "chess",
    label: "chess",
    blurb: "PGN and SAN: the notation chess games are written in",
  },
  {
    id: "semver",
    label: "semver",
    blurb: "Semantic Versioning 2.0.0: the version strings on every release page",
  },
  {
    id: "gbnf",
    label: "gbnf",
    blurb: "GBNF: the grammars that constrain what a model may say",
  },
  ...PROJECTS.map((p) => ({ id: p.id, label: p.name, blurb: p.tagline })),
  {
    id: "the-grammars-themselves",
    label: "The grammars themselves",
    blurb: "The packages read as examples in their own right, each extending another",
  },
  {
    id: "built-something",
    label: "Built something?",
    blurb: "Where to say so, and why usage is the most useful thing to report",
  },
];

// The blurb is written once, in SECTIONS, and read back here for the
// section's own tagline. Two copies of the same sentence would drift, and
// the one under the heading is the one a reader checks the link against.
const blurb = (id: string): string => {
  const found = SECTIONS.find((s) => s.id === id);
  if (!found) throw new Error(`examples: no SECTIONS entry for ${id}`);
  return found.blurb;
};
---

<Base
  wide
  title="Examples"
  description="Real languages built on the tabnas engine: a chess game to step through, semver strings parsed and ranked, a GBNF grammar to test, aontu in TS and boru in Go."
>
  <article class="ex">
    <Heading level={1} id="examples">Examples</Heading>
    <p class="lede">
      Three small languages running in this page, and two large ones you can
      go and read. One parses chess notation, one the version strings on every
      release page, and one the grammars that constrain what a language model
      may say. Of the large ones, one composes existing grammar plugins into a
      configuration language, and the other builds a full programming language
      and its toolchain.
    </p>

    {/* Section links. A <p> rather than a heading, and marked
        data-pagefind-ignore, for the reason the /how-to index gives: these
        labels repeat every heading on the page, and indexing them once more
        would put the same seven words in front of every result. */}
    <nav class="toc" aria-label="Sections on this page" data-pagefind-ignore>
      <p class="toc-head">On this page</p>
      <ul>
        {SECTIONS.map((s) => (
          <li>
            <a href={`#${s.id}`}>{s.label}</a>
            <span>{s.blurb}</span>
          </li>
        ))}
      </ul>
    </nav>

    <section class="proj">
      <Heading level={2} id="chess">chess</Heading>
      <p class="tagline">{blurb("chess")}</p>

      <dl class="meta">
        <div><dt>Runtime</dt><dd>TypeScript · also ported to Go</dd></div>
        <div>
          <dt>Built with</dt>
          <dd class="pkgs">
            <a class="chip" href={REPO("parser")} target="_blank" rel="noopener">@tabnas/parser</a>
          </dd>
        </div>
        <div>
          <dt>Source</dt>
          <dd><a href={REPO("chess")} target="_blank" rel="noopener">github.com/tabnas/chess</a></dd>
        </div>
      </dl>

      <details class="src">
        <summary>The input, in full</summary>
        <pre>{IMMORTAL}</pre>
      </details>

      <div class="board">
        <chess-view source="edit">{IMMORTAL}</chess-view>
      </div>
      <p class="caption">
        Anderssen–Kieseritzky, London, 21 June 1851: the Immortal Game. Use
        the controls, the arrow keys, or click any move. The notation below
        the board is <strong>editable</strong>: change it and the board
        re-parses as you type, so you can watch the grammar accept and
        reject. The board, the move list and the parser are one
        37&nbsp;kB script with no other requests.
      </p>

      <p>
        That text is the whole input: a PGN game, parsed by
        <a href={REPO("chess")} target="_blank" rel="noopener">@tabnas/chess</a>
        into tag pairs, moves and a result. Everything on the board comes from
        the parse: the players and date above it are the tag pairs, and each
        move comes back as structure rather than as a string:
        <code>Nxg7+</code> is a knight, a capture, a destination of
        <code>g7</code> and a check. That is what makes the move list
        clickable and lets the board follow along.
      </p>
      <p>
        It is also a good example of where a parser stops. <code>Nf3</code>
        names a piece and a square but not <em>which</em> knight; only the
        position knows, and the grammar has no position. So the plugin does not
        pretend to have a board, and the component supplies the missing half: a
        legal move generator that resolves each parsed move against the
        position it is played in. Parsing the notation and playing the game are
        two jobs, and only one of them is the engine's.
      </p>
    </section>

    <section class="proj">
      <Heading level={2} id="semver">semver</Heading>
      <p class="tagline">{blurb("semver")}</p>

      <dl class="meta">
        <div><dt>Runtime</dt><dd>TypeScript · also ported to Go</dd></div>
        <div>
          <dt>Built with</dt>
          <dd class="pkgs">
            <a class="chip" href={REPO("parser")} target="_blank" rel="noopener">@tabnas/parser</a>
            <a class="chip" href={REPO("abnf")} target="_blank" rel="noopener">@tabnas/abnf</a>
          </dd>
        </div>
        <div>
          <dt>Source</dt>
          <dd><a href={REPO("semver")} target="_blank" rel="noopener">github.com/tabnas/semver</a></dd>
        </div>
      </dl>

      <div class="sv" data-sv>
        <div class="sv-panes">
          <label>
            <span>simple</span>
            <textarea data-sv-simple spellcheck="false" rows="4">{SEMVER_SIMPLE}</textarea>
          </label>
          <label>
            <span>complex</span>
            <textarea data-sv-complex spellcheck="false" rows="6">{SEMVER_COMPLEX}</textarea>
          </label>
        </div>
        <output data-sv-out class="sv-out"></output>
        <p class="sv-order" data-sv-order></p>
      </div>
      <p class="caption">
        Both boxes are <strong>editable</strong>, and every line re-parses as
        you type. The left one holds ordinary releases. The right one holds
        the cases that separate a parser from a pattern match: an identifier
        that sorts by value rather than by character, one made of nothing but
        hyphens, an integer past <code>Number.MAX_SAFE_INTEGER</code>, and a
        <code>v</code> prefix the specification does not allow.
      </p>

      <p>
        An accepted line comes back as five fields rather than as a string.
        <code>1.0.0-alpha.beta.11+exp.sha.5114f85</code> gives a core of
        <code>1</code>, <code>0</code>, <code>0</code>, a
        <code>prerelease</code> of <code>["alpha", "beta", 11]</code> and a
        <code>build</code> of <code>["exp", "sha", "5114f85"]</code>. The
        <code>11</code> is a number and <code>"beta"</code> a string because
        the specification ranks the two kinds by different rules, so the
        difference has to survive the parse. An integer above
        <code>2^53 - 1</code> comes back as a <code>bigint</code> rather than
        rounded to the nearest double.
      </p>
      <p>
        The specification publishes its grammar, in BNF. The plugin
        transcribes it into RFC 5234 ABNF, one production per production and
        under the same names, and
        <a href={REPO("abnf")} target="_blank" rel="noopener">@tabnas/abnf</a>
        compiles that text into the engine's rule set when the plugin is
        installed. Nothing in the plugin's code decides what a valid version
        is. That the result accepts exactly what semver.org accepts is
        checked rather than asserted: both runtimes generate a corpus of
        58,449 strings and compare every verdict, every value and every
        round trip against the regular expression semver.org publishes for
        the purpose.
      </p>
      <p>
        Ranking versions is a second job. Section 11 puts
        <code>1.0.0-beta.2</code> below <code>1.0.0-beta.11</code>, puts any
        pre-release below the release it leads to, and gives build metadata
        no weight at all. A grammar can state none of that. So
        <code>compare</code> sits beside the parser as an ordinary function
        over parsed values, and the strip under the verdicts is the accepted
        lines above passed through it and
        <code>Array.prototype.sort</code>. The package is new, at 0.0.2, and
        that corpus is the reason to trust it rather than its time in
        service.
      </p>
    </section>

    <section class="proj">
      <Heading level={2} id="gbnf">gbnf</Heading>
      <p class="tagline">{blurb("gbnf")}</p>

      <dl class="meta">
        <div><dt>Runtime</dt><dd>TypeScript · also ported to Go, C ABI, Python</dd></div>
        <div>
          <dt>Built with</dt>
          <dd class="pkgs">
            <a class="chip" href={REPO("parser")} target="_blank" rel="noopener">@tabnas/parser</a>
            <a class="chip" href={REPO("bnf")} target="_blank" rel="noopener">@tabnas/bnf</a>
          </dd>
        </div>
        <div>
          <dt>Source</dt>
          <dd><a href={REPO("gbnf")} target="_blank" rel="noopener">github.com/tabnas/gbnf</a></dd>
        </div>
      </dl>

      <div class="gbnf" data-gbnf>
        <div class="gbnf-panes">
          <label>
            <span>grammar</span>
            <textarea data-gbnf-grammar spellcheck="false" rows="4">{GBNF_GRAMMAR}</textarea>
          </label>
          <label>
            <span>samples, one per line</span>
            <textarea data-gbnf-samples spellcheck="false" rows="5">{GBNF_SAMPLES}</textarea>
          </label>
        </div>
        <output data-gbnf-out class="gbnf-out"></output>
      </div>
      <p class="caption">
        Both boxes are <strong>editable</strong>, and the verdicts re-run as
        you type. Every character counts: GBNF is scannerless, so
        <code>yes&nbsp;&nbsp;(90%)</code> is rejected for the second space.
        Break the grammar itself and you get a compile error instead of
        verdicts, which is the distinction the tool exists to keep.
      </p>

      <p>
        GBNF is llama.cpp's notation for <strong>constrained decoding</strong>:
        at each step the sampler masks every token that would leave the
        grammar's language, so the model cannot emit malformed output.
        XGrammar reads it too, and therefore so do vLLM and SGLang, along with
        KoboldCpp, LocalAI and node-llama-cpp.
      </p>
      <p>
        In all of them the grammar runs inside generation and nowhere else.
        None can answer <em>does this string match my grammar?</em> without
        loading a model, which leaves two questions open. Text produced
        without the grammar was never checked against it. And a grammar can
        compile, constrain a model perfectly, and still accept a different
        language than its author meant. That is what this parses GBNF for:
        the grammar becomes an ordinary tabnas grammar, so you can run
        known-good samples through it before a model ever sees it.
      </p>
      <p>
        It is also the front end that pushed the engine furthest. GBNF
        describes input one character at a time while tabnas is a tokenising
        parser, so the compiled grammar has to switch off every default
        matcher and empty the ignore set. Those lexer settings are part of the
        accepted language rather than a tuning choice, which is why the
        package owns them and the shared
        <a href={REPO("bnf")} target="_blank" rel="noopener">@tabnas/bnf</a>
        compiler owns everything downstream of the IR.
      </p>
    </section>

    {PROJECTS.map((p) => (
      <section class="proj">
        <Heading level={2} id={p.id}>{p.name}</Heading>
        <p class="tagline">{p.tagline}</p>

        <dl class="meta">
          <div><dt>Runtime</dt><dd>{p.runtime}</dd></div>
          <div>
            <dt>Built with</dt>
            <dd class="pkgs">
              {p.uses.map((u) => (
                <a class="chip" href={REPO(u)} target="_blank" rel="noopener">@tabnas/{u}</a>
              ))}
            </dd>
          </div>
          <div>
            <dt>Source</dt>
            <dd><a href={p.url} target="_blank" rel="noopener">{p.url.replace("https://github.com/", "github.com/")}</a></dd>
          </div>
        </dl>

        {p.body.map((para) => <p>{para}</p>)}
      </section>
    ))}

    <section class="proj">
      <Heading level={2} id="the-grammars-themselves">The grammars themselves</Heading>
      <p>
        The grammar packages are worth reading as examples in their own right,
        because most of them are short and each one extends another. The
        clearest chain is JSON: <a href={REPO("json")} target="_blank" rel="noopener">json</a>
        is a handful of rules, <a href={REPO("jsonc")} target="_blank" rel="noopener">jsonc</a>
        adds comments to them, and <a href={REPO("jsonic")} target="_blank" rel="noopener">jsonic</a>
        relaxes the quoting from there. For a grammar compiled from a
        specification rather than hand-written, see
        <a href={REPO("proto")} target="_blank" rel="noopener">proto</a>, which
        parses the Protocol Buffers IDL from an ABNF grammar.
      </p>
      <p>
        The full list is on the <a href="/releases/">releases</a> page, and the
        <a href="/docs/">docs</a> build two grammars from nothing: one
        standalone, one on top of an existing plugin.
      </p>
    </section>

    <section class="proj">
      <Heading level={2} id="built-something">Built something?</Heading>
      <p>
        If you've used tabnas for anything (a config dialect, a log format, a
        query language, an experiment that didn't work) it's worth saying so in
        <a href={`${GITHUB_ORG}/parser/discussions`} target="_blank" rel="noopener">Discussions</a>.
        Real usage is the most useful thing a project this early can get, and
        this page is short precisely because there isn't much of it yet.
      </p>
    </section>
  </article>
</Base>

{/* @tabnas/chess-view, an ordinary pinned dependency — it was a vendored
    file in public/ only for as long as it had to be. Importing it registers
    <chess-view> and does nothing else; until the bundle loads — or with
    JavaScript off — the :not(:defined) rule below hides the element, and
    the reader still has the game, because the PGN is on the page in its own
    right. */}
<script>
  import "@tabnas/chess-view";
</script>

{/* The semver demo. One engine instance for the page: unlike gbnf, the
    grammar is fixed, so nothing an edit can do changes the rule set, and
    compiling the ABNF is the expensive step. Without JavaScript the two
    textareas still show the version strings, and the prose says what the
    parser makes of them. */}
<script>
  import { Tabnas } from "@tabnas/parser";
  import { Semver, compare, format } from "@tabnas/semver";

  const root = document.querySelector("[data-sv]");
  if (root) {
    const simpleEl = root.querySelector("[data-sv-simple]");
    const complexEl = root.querySelector("[data-sv-complex]");
    const outEl = root.querySelector("[data-sv-out]");
    const orderEl = root.querySelector("[data-sv-order]");

    const tn = new Tabnas().use(Semver);

    // Engine diagnostics are coloured for a terminal and run to several
    // lines. A verdict line is neither.
    const oneLine = (e) =>
      String(e && e.message ? e.message : e)
        .split("\n")[0]
        .replace(/\u001b\[[0-9;]*m/g, "");

    // JSON.stringify throws on a bigint, and a bigint is exactly what the
    // interesting line produces. Render the value by hand: an integer as
    // digits, a numeric pre-release identifier as digits, an alphanumeric
    // one quoted — which is the distinction the value exists to record.
    const num = (n) => ("bigint" === typeof n ? n + "n" : String(n));
    const ident = (x) => ("string" === typeof x ? JSON.stringify(x) : num(x));
    const value = (v) =>
      "{ major: " + num(v.major) +
      ", minor: " + num(v.minor) +
      ", patch: " + num(v.patch) +
      ", prerelease: [" + v.prerelease.map(ident).join(", ") + "]" +
      ", build: [" + v.build.map((x) => JSON.stringify(x)).join(", ") + "] }";

    const run = () => {
      const lines = [
        ...simpleEl.value.split("\n"),
        ...complexEl.value.split("\n"),
      ].filter((s) => "" !== s);

      const parsed = [];
      const rows = lines.map((src) => {
        try {
          const v = tn.parse(src);
          parsed.push(v);
          return row("accept", src, value(v));
        } catch (e) {
          return row("reject", src, oneLine(e));
        }
      });
      outEl.replaceChildren(...rows);

      // compare is a consistent comparator, so sort takes it as it is.
      // Versions that differ only in build metadata compare 0 and keep the
      // order they were given, which is what the specification asks for.
      orderEl.replaceChildren(
        ...parsed
          .sort(compare)
          .map(format)
          .flatMap((s, i) => {
            const el = document.createElement("code");
            el.textContent = s;
            // A no-break space before the operator, so a line can only wrap
            // after a `<` and never begin with one.
            return 0 === i ? [el] : [document.createTextNode("\u00a0< "), el];
          })
      );
    };

    function row(kind, text, why) {
      const el = document.createElement("div");
      el.className = "sv-row sv-" + kind;
      const tag = document.createElement("b");
      tag.textContent = kind;
      const body = document.createElement("code");
      body.textContent = text;
      el.append(tag, body);
      if (why) {
        const note = document.createElement("small");
        note.textContent = why;
        el.append(note);
      }
      return el;
    }

    simpleEl.addEventListener("input", run);
    complexEl.addEventListener("input", run);
    run();
  }
</script>

{/* The gbnf demo. Bundled the same way as chess-view — ordinary pinned
    dependencies, no vendored files. Without JavaScript the two textareas
    still show the grammar and the samples as text, which is the whole
    input; only the verdicts are missing, and the prose says what they are. */}
<script>
  import { Tabnas } from "@tabnas/parser";
  import { gbnf } from "@tabnas/gbnf";

  const root = document.querySelector("[data-gbnf]");
  if (root) {
    const grammarEl = root.querySelector("[data-gbnf-grammar]");
    const samplesEl = root.querySelector("[data-gbnf-samples]");
    const outEl = root.querySelector("[data-gbnf-out]");

    // Engine diagnostics are coloured for a terminal and run to several
    // lines. A verdict line is neither.
    const oneLine = (e) =>
      String(e && e.message ? e.message : e)
        .split("\n")[0]
        .replace(/\u001b\[[0-9;]*m/g, "");

    const run = () => {
      const src = grammarEl.value;
      const samples = samplesEl.value.split("\n").filter((s) => "" !== s);

      // A FRESH instance per compile, deliberately: a GBNF grammar's lexer
      // settings are instance-wide, so reusing one across grammars would let
      // the previous grammar's settings decide this grammar's language.
      // Within one grammar the instance is reusable, and gbnf-check does the
      // same — compile once, check every sample against it.
      let tn;
      try {
        tn = new Tabnas({ plugins: [gbnf] });
        tn.gbnf(src);
      } catch (e) {
        outEl.replaceChildren(row("compile", "grammar", oneLine(e)));
        return;
      }

      const rows = samples.map((sample) => {
        try {
          tn.parse(sample);
          return row("accept", sample, "");
        } catch (e) {
          return row("reject", sample, oneLine(e));
        }
      });
      outEl.replaceChildren(...rows);
    };

    function row(kind, text, why) {
      const el = document.createElement("div");
      el.className = "gbnf-row gbnf-" + kind;
      const tag = document.createElement("b");
      tag.textContent =
        "compile" === kind ? "grammar" : "accept" === kind ? "accept" : "reject";
      const body = document.createElement("code");
      body.textContent = "compile" === kind ? why : text;
      el.append(tag, body);
      if (why && "compile" !== kind) {
        const note = document.createElement("small");
        note.textContent = why;
        el.append(note);
      }
      return el;
    }

    grammarEl.addEventListener("input", run);
    samplesEl.addEventListener("input", run);
    run();
  }
</script>

<script is:inline>
  // The component's own theme="auto" follows prefers-color-scheme, but this
  // site's theme is a data-theme attribute the reader can toggle against
  // their OS. Mirror it, or someone on a light machine who picks dark here
  // gets a bright board on a dark page. theme is read only by the shadow
  // stylesheet, so setting it before the element upgrades is fine.
  (() => {
    const root = document.documentElement;
    const sync = () => {
      const theme = root.getAttribute("data-theme") === "dark" ? "dark" : "light";
      for (const el of document.querySelectorAll("chess-view")) {
        el.setAttribute("theme", theme);
      }
    };
    sync();
    new MutationObserver(sync).observe(root, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>

