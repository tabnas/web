---
import { getCollection, render } from "astro:content";
import HowToLayout from "../../layouts/HowToLayout.astro";

// One page per guide in the `howto` collection. Enumerated at build time so
// every guide lands on disk as HTML — which is what Pagefind indexes.
// The index page is /how-to/index.astro, not a member of this collection.
export async function getStaticPaths() {
  const guides = await getCollection("howto");
  return guides.map((g) => ({ params: { slug: g.id }, props: { entry: g } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<HowToLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  packages={entry.data.packages}
  headings={headings}
>
  <Content />
</HowToLayout>
