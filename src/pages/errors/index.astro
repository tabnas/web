---
import Base from "../../layouts/Base.astro";
import Heading from "../../components/Heading.astro";
import registry from "../../data/error-codes.json";
import plugindata from "../../data/plugins.json";
import pkg from "../../../package.json";
import { REPO } from "../../consts";

// Two engine versions are in play and conflating them would mislead: the
// catalogue is generated from the parser repository's schema (which tracks
// main), while the site's examples run against the version pinned in
// package.json. They are usually the same and occasionally not, so the page
// states both rather than picking one and being quietly wrong.
const sitePin = (pkg.dependencies as Record<string, string>)["@tabnas/parser"];
const catalogueVersion = registry.engine;
const versionsAgree = sitePin === catalogueVersion;

// The error reference. Every code the fleet can raise, in one place, so an
// agent that has a `code` in a diagnostic has somewhere to look it up —
// which is the whole reason the code, and not the message, is the contract.
//
// Both halves are GENERATED (tools/gen-ax-data.mjs, staleness-checked by
// `npm run check`): the engine's nine base codes come from the parser repo's
// schema/error-codes.json, and each plugin's own codes from its
// tabnas.plugin.json descriptor. Nothing here is hand-listed.

const engine = registry.codes;

// Plugin codes, flattened to one row per code. A code is declared by exactly
// one plugin today; if that ever stops being true the extra owners show up
// here rather than being silently dropped.
const owners = new Map<string, { name: string; repo: string }[]>();
for (const p of plugindata.plugins) {
  for (const code of p.errorCodes) {
    if (!owners.has(code)) owners.set(code, []);
    owners.get(code)!.push({ name: p.name, repo: p.repo });
  }
}
const pluginCodes = [...owners.entries()]
  .map(([code, by]) => ({ code, by }))
  .sort((a, b) => a.code.localeCompare(b.code));

// The C ABI's own codes (ADR-12). A THIRD namespace, deliberately kept apart
// from the two above: these come back in the JSON reply of a libtabnas*
// shared library, and they describe the CALL rather than the input. `internal`
// exists in two of the three namespaces meaning different things — a
// recovered plugin panic in the engine, a failed FFI call here — which is
// exactly why the lists are not merged.
const abiLibraries = plugindata.plugins.filter((p) => p.clib);
const abiOwners = new Map<string, string[]>();
for (const p of abiLibraries) {
  for (const code of p.clib!.errorCodes) {
    if (!abiOwners.has(code)) abiOwners.set(code, []);
    abiOwners.get(code)!.push(p.name);
  }
}
const abiCodes = [...abiOwners.keys()].sort();

// One ABI version across the whole fleet is the invariant ADR-12 buys.
// Deriving the set rather than assuming a single value means a split shows up
// on the page instead of being quietly averaged away.
const abiVersions = [...new Set(abiLibraries.map((p) => p.clib!.abi))].sort();

// Distinct codes, not the sum of the three lists: a code carried by more than
// one namespace has one page, and claiming otherwise would overstate by
// exactly the overlap the page is trying to explain.
const distinct = new Set([
  ...engine.map((c) => c.code),
  ...pluginCodes.map((c) => c.code),
  ...abiCodes,
]).size;
---

<Base
  wide
  title="Error reference"
  description="Every error code the tabnas engine and its grammar plugins can raise, what it means, and where it is declared."
>
  <article class="errors" data-pagefind-body>
    <Heading level={1} id="errors">The tabnas error reference</Heading>
    <p class="lede">
      {distinct} error codes in three namespaces: {engine.length} raised by the
      engine itself, {pluginCodes.length} declared by individual grammar
      plugins, and {abiCodes.length} returned by the C shared libraries. A
      tabnas diagnostic always carries a <code>code</code>, and the code — never
      the message text — is what stays the same across the TypeScript and Go
      runtimes. Match on it.
    </p>

    <p class="note">
      Generated from the engine's{" "}
      <a href={`${REPO("parser")}/blob/main/schema/error-codes.json`} target="_blank" rel="noopener">
        <code>schema/error-codes.json</code></a>{" "}
      and from each plugin's <code>tabnas.plugin.json</code> descriptor —
      nothing on this page is hand-listed.{" "}
      {versionsAgree ? (
        <>Engine {catalogueVersion}.</>
      ) : (
        <>
          The catalogue comes from engine {catalogueVersion}; this site's
          examples pin <code>@tabnas/parser</code> {sitePin}.
        </>
      )}{" "}
      Machine-readable:{" "}
      <a href="/versions.json"><code>/versions.json</code></a>.
    </p>

    <section class="group">
      <Heading level={2} id="engine">Engine codes</Heading>
      <p class="blurb">
        Raised by the parsing engine itself, so any grammar can produce them.
        <code>{"{placeholders}"}</code> in a message are filled from the failing
        token and its details.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Code</th><th>Message</th></tr>
          </thead>
          <tbody>
            {engine.map((c) => (
              <tr>
                <th scope="row">
                  <a href={`/errors/${c.code}/`}><code>{c.code}</code></a>
                  {"go" === c.runtime && <span class="tag" title="Go runtime only — TypeScript has no counterpart">Go only</span>}
                </th>
                <td class="msg"><code>{c.message}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="group">
      <Heading level={2} id="plugin">Plugin codes</Heading>
      <p class="blurb">
        Declared by one grammar plugin, in its own error catalogue. A plugin
        raises these in addition to the engine codes above.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Code</th><th>Declared by</th></tr>
          </thead>
          <tbody>
            {pluginCodes.map((c) => (
              <tr>
                <th scope="row"><a href={`/errors/${c.code}/`}><code>{c.code}</code></a></th>
                <td class="msg">
                  {c.by.map((b) => (<code class="pkg">{b.name}</code>))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {abiCodes.length > 0 && (
      <section class="group">
        <Heading level={2} id="abi">C ABI codes</Heading>
        <p class="blurb">
          A different namespace, and worth reading as one. These are not parse
          diagnostics: they come back in the JSON reply of a{" "}
          <code>libtabnas&lt;format&gt;</code> shared library, and they describe
          the <em>call</em> — a bad pointer, a handle you already freed — rather
          than the input you passed. All{" "}
          {abiLibraries.length} libraries return the same four, because the ABI
          is uniform by decision
          {1 === abiVersions.length ? (
            <> (<code>{abiVersions[0]}</code>)</>
          ) : (
            <> (versions in the fleet right now: {abiVersions.map((v) => (<code>{v}</code>))} — they are meant to agree)</>
          )}.
        </p>
        <p class="blurb">
          The distinction that actually costs people time: a library returns{" "}
          <code>{'{"ok":true,"accept":false}'}</code> when your input is outside
          the format. That is an <strong>answer</strong>, not an error, and it
          carries no code from this table. A code from this table means the call
          itself was wrong.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Code</th><th>Returned by</th></tr>
            </thead>
            <tbody>
              {abiCodes.map((code) => (
                <tr>
                  <th scope="row"><a href={`/errors/${code}/`}><code>{code}</code></a></th>
                  <td class="msg">
                    {abiOwners.get(code)!.length === abiLibraries.length
                      ? <span>every clib ({abiLibraries.length})</span>
                      : abiOwners.get(code)!.map((n) => (<code class="pkg">{n}</code>))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="group">
      <Heading level={2} id="reading">Reading a diagnostic</Heading>
      <p class="blurb">
        Every failing parse produces the same structured object — the same
        fields in both runtimes, described by the engine's{" "}
        <a href={`${REPO("parser")}/blob/main/schema/diagnostic.schema.json`} target="_blank" rel="noopener">
          <code>diagnostic.schema.json</code></a>. The fields worth reading
        first are <code>code</code> (what went wrong),{" "}
        <code>row</code>/<code>col</code> (where), <code>expected</code> (which
        tokens would have matched) and <code>ruleStack</code> (how the parser
        got there).
      </p>
      <p class="blurb">
        The <a href="/agents/">agents guide</a> covers using these while
        iterating on a grammar, and the{" "}
        <a href="/skills/"><code>debug-parse</code> skill</a> is the same
        workflow packaged for an agent.
      </p>
    </section>
  </article>
</Base>

<style>
  .errors { max-width: 60rem; }
  .errors :global(h1) { font-size: clamp(2.2rem, 5vw, 3rem); margin: 0 0 1rem; }
  .lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 62ch; }
  .note { color: var(--ink-mute); font-size: 0.9rem; max-width: 68ch; }
  .blurb { color: var(--ink-soft); max-width: 68ch; }

  .group { margin-top: 3rem; }
  .errors :global(h2) { font-size: 1.5rem; margin: 0 0 0.85rem; }

  .table-wrap { overflow-x: auto; }
  table { width: 100%; min-width: 34rem; border-collapse: collapse; font-size: 0.95rem; }
  th:nth-child(1), td:nth-child(1) { width: 16rem; }
  th, td { text-align: left; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  thead th {
    font-family: var(--font-mono); font-size: 0.68rem;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-mute);
    font-weight: 400; white-space: nowrap;
  }
  tbody th { font-weight: 400; white-space: nowrap; }
  .msg { color: var(--ink-soft); }
  .msg code { font-size: 0.85rem; }
  .pkg { margin-right: 0.5rem; }
  .tag {
    margin-left: 0.5rem; font-family: var(--font-mono); font-size: 0.65rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-mute);
    border: 1px solid var(--border); border-radius: 3px; padding: 0.05rem 0.3rem;
    vertical-align: middle;
  }
</style>
