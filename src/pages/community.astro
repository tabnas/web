---
import Base from "../layouts/Base.astro";
import { GITHUB_ORG, REPO, SPONSOR } from "../consts";
---

<Base title="Community" description="Get help, share ideas, and contribute to tabnas.">
  <h1>Community &amp; contributing</h1>
  <p class="lede">
    tabnas is open source and built in the open. Whether you're adopting it,
    reporting a bug, or adding a grammar, there's a place for you.
  </p>

  <div class="signals" id="signals" aria-label="Project activity">
    <div class="sig"><span class="n" id="sig-stars">—</span><span class="l">stars</span></div>
    <div class="sig"><span class="n" id="sig-release">—</span><span class="l">latest release</span></div>
    <a class="sig" id="sig-gfi-link" href={`${GITHUB_ORG}/parser/contribute`} target="_blank" rel="noopener">
      <span class="n" id="sig-gfi">—</span><span class="l">good first issues</span>
    </a>
  </div>

  <div class="cards">
    <a class="card" href={`${GITHUB_ORG}/parser/discussions`} target="_blank" rel="noopener">
      <h2>Discuss</h2>
      <p>Ask questions and share what you're building in GitHub Discussions.</p>
    </a>
    <a class="card" href={`${REPO("parser")}/issues`} target="_blank" rel="noopener">
      <h2>Report</h2>
      <p>File issues and feature requests on the relevant repository.</p>
    </a>
    <a class="card" href="https://github.com/tabnas/web/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">
      <h2>Contribute</h2>
      <p>Read the contributing guide, then pick a “good first issue”.</p>
    </a>
  </div>

  <h2>How the project works</h2>
  <ul>
    <li><strong>TypeScript is canonical; Go tracks it.</strong> Changes land in TS first, then Go to match.</li>
    <li><strong>One grammar, shared fixtures.</strong> Both implementations parse the same test grammars and must agree.</li>
    <li><strong>Small, focused packages.</strong> The engine stays lean; languages live in their own repos.</li>
  </ul>

  <p class="conduct">
    We give every first contribution a prompt, welcoming response, and we hold to
    a <a href="https://github.com/tabnas/web/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener">Code of Conduct</a>.
    {SPONSOR.blurb} — see the <a href="/sponsors">sponsors</a> page.
  </p>
</Base>

<script>
  // Live project signals (unauthenticated GitHub API; best-effort).
  (async () => {
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    try {
      const res = await fetch("https://api.github.com/orgs/tabnas/repos?per_page=100&type=public");
      if (res.ok) {
        const repos = await res.json();
        const stars = repos.reduce((n, r) => n + (r.stargazers_count || 0), 0);
        set("sig-stars", stars >= 1000 ? (stars / 1000).toFixed(1) + "k" : String(stars));
      }
    } catch {}
    try {
      const res = await fetch("https://api.github.com/repos/tabnas/parser/releases/latest");
      if (res.ok) { const r = await res.json(); set("sig-release", r.tag_name || "—"); }
      else set("sig-release", "—");
    } catch {}
    try {
      const res = await fetch('https://api.github.com/search/issues?q=' +
        encodeURIComponent('org:tabnas is:issue is:open label:"good first issue"'));
      if (res.ok) { const r = await res.json(); set("sig-gfi", String(r.total_count ?? 0)); }
    } catch {}
  })();
</script>

<style>
  .lede { font-size: 1.15rem; color: var(--ink-soft); max-width: 60ch; }
  .signals { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; align-items: center;
    border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.3rem; margin: 1.25rem 0 1.75rem;
    background: var(--surface); }
  .sig { display: flex; flex-direction: column; text-decoration: none; line-height: 1.15; }
  .sig .n { font-family: var(--font-heading); font-weight: 700; font-size: 1.5rem; color: var(--primary); font-variant-numeric: tabular-nums; }
  .sig .l { font-size: 0.75rem; color: var(--ink-mute); text-transform: uppercase; letter-spacing: 0.08em; }
  a.sig:hover .n { text-decoration: underline; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 1rem 0; }
  .card { display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; background: var(--surface); }
  .card:hover { border-color: var(--border-strong); }
  .card h2 { font-size: 1.2rem; margin: 0 0 0.35rem; color: var(--ink); }
  .card p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  .conduct { color: var(--ink-soft); }
  @media (max-width: 760px) { .cards { grid-template-columns: 1fr; } }
</style>
