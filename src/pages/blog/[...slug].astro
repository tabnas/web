---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Rendered on-demand: while the under-construction Basic-Auth gate is
// active the site runs output:"server", so every page (blog posts
// included) passes through the auth middleware. At launch, revert to
// output:"static" and restore getStaticPaths() for a prerendered blog.
const { slug } = Astro.params;
const post = slug ? await getEntry('blog', slug) : undefined;
if (!post) {
	return new Response('Not found', { status: 404 });
}
const { Content } = await render(post);
---

<BlogPost {...post.data}>
	<Content />
</BlogPost>
