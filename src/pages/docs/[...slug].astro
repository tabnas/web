---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

// Renders the docs content collection through the custom DocsLayout.
// `/docs` (empty slug) shows the introduction. On-demand while the site is
// gated (output:"server"); at the static launch these prerender and Pagefind
// indexes them for search.
const { slug } = Astro.params;
const wanted = (slug || "introduction").replace(/\/$/, "");
const docs = await getCollection("docs");
const entry = docs.find((d) => d.id === wanted);
if (!entry) {
  return new Response("Not found", { status: 404 });
}
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
  headings={headings}
>
  <Content />
</DocsLayout>
