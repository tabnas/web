{
	"name": "tabnas-web",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker.ts",
	"routes": [
		{ "pattern": "tabnas.dev", "custom_domain": true },
		{ "pattern": "www.tabnas.dev", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": [
			"/*",
			"!/_astro/*",
			"!/pagefind/*",
			"!/fonts/*",
			"!/brand/*",
			"!/diagrams/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
