# Cache policy for the files the asset server hands out directly.
#
# Cloudflare's default for static assets is `public, max-age=0,
# must-revalidate`, which is right for HTML on a site that redeploys — a
# reader should never be shown a stale page — and wrong for everything
# below, which was revalidating a font and a stylesheet on every navigation.
#
# HTML is deliberately absent: it keeps the default. So does /pagefind/,
# which the build regenerates wholesale on every deploy.
#
# The font and image paths are excluded from `run_worker_first`; the asset
# server answers them directly. The schema passes through the Worker so a
# missing path or unsupported method keeps the structured JSON error contract,
# and the successful asset response keeps these custom headers.

# Content-hashed by the build: the filename changes whenever the bytes do,
# so a year is safe and `immutable` saves the revalidation round trip.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed — these keep their names across deploys, so they cannot be
# immutable: a replaced font under the same name has to reach readers
# eventually. Thirty days, revalidated after that.
/fonts/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
/diagrams/*
  Cache-Control: public, max-age=2592000

# Stable contract URL: cache briefly so an editor is not fetching the same
# schema on every validation, but let a corrected contract reach it promptly.
/schema/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
